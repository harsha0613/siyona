# Copy to .env and fill in locally. .env is gitignored; never commit real keys.

# --- Vendors (placeholders only) ---
# Each voice vendor falls back to an in-memory mock while its key is a placeholder.
DEEPGRAM_API_KEY=your-deepgram-key-here
OPENAI_API_KEY=your-openai-key-here
CARTESIA_API_KEY=your-cartesia-key-here
# Places search, place details and directions; MockMaps (finds nothing) while unset
GOOGLE_MAPS_API_KEY=your-google-maps-key-here
TELEPHONY_ACCOUNT_SID=your-telephony-account-sid-here
TELEPHONY_AUTH_TOKEN=your-telephony-auth-token-here
TELEPHONY_FROM_NUMBER=+15550000000
# Public base URL the telephony vendor calls back into (status + media stream)
VOICE_PUBLIC_URL=http://localhost:8001
# Public base URL of the gateway; call status callbacks are sent to <this>/telephony/status
GATEWAY_PUBLIC_URL=http://localhost:8000
# HMAC key for media-stream tokens
LINK_SIGNING_KEY=dev-link-key-not-for-production

# --- WhatsApp Business API ---
WHATSAPP_APP_SECRET=dev-secret-not-for-production
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Leave unset to use the in-memory MockWhatsApp (nothing is sent)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
WHATSAPP_API_VERSION=v21.0

# --- Models ---
LLM_MODEL=gpt-4.1
STT_MODEL=nova-3
# Cartesia voice id; leave as "default" to use the mock TTS
TTS_VOICE_ID=default
TTS_MODEL=sonic-2
CARTESIA_VERSION=2024-06-10
CALL_LANGUAGE=en

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://siyona:siyona@postgres:5432/siyona
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# --- Product limits ---
TARGET_TURN_LATENCY_MS=300
# Turns slower than this are logged as warnings with their STT / model / TTS breakdown
SLOW_TURN_MS=500
# Play a filler if no reply audio has gone out this long after the caller finished
STALL_FILLER_MS=800
MAX_CALL_DURATION_S=600
MAX_ATTEMPTS_PER_NUMBER=3
# Seconds a who/what/when summary waits for YES before the task is cancelled
CONFIRMATION_TIMEOUT_S=600
# Seconds after dialling before the user gets a "still on the line" update
EXPECTED_CALL_WINDOW_S=180
TRANSCRIPT_RETENTION_DAYS=30
